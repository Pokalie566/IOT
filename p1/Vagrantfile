LOGIN     = "adeboose"
SERVER_IP = "192.168.56.110"
WORKER_IP = "192.168.56.111"
BOX       = "bento/ubuntu-26.04"

Vagrant.configure("2") do |config|
  config.vm.box = BOX

  #============================Server VM==============================
  config.vm.define "#{LOGIN}S" do |control|
    control.vm.hostname = "#{LOGIN}S"
    control.vm.network "private_network", ip: SERVER_IP

    control.vm.provider "virtualbox" do |v|
      v.name = "#{LOGIN}S"
      v.memory = 1024
      v.cpus = 1
      v.gui = false
    end

    control.vm.provider "vmware_desktop" do |v|
      v.vmx["displayname"] = "#{LOGIN}S"
      v.memory = 1024
      v.cpus = 1
      v.gui = false
    end
    control.vm.provision "shell", path: "scripts/install_server.sh", args: [SERVER_IP]
  end

  #===========================Worker VM==============================
  config.vm.define "#{LOGIN}SW" do |control|
    control.vm.hostname = "#{LOGIN}SW"
    control.vm.network "private_network", ip: WORKER_IP

    control.vm.provider "virtualbox" do |v|
      v.name = "#{LOGIN}SW"
      v.memory = 1024
      v.cpus = 1
      v.gui = false
    end

    control.vm.provider "vmware_desktop" do |v|
      v.vmx["displayname"] = "#{LOGIN}SW"
      v.memory = 1024
      v.cpus = 1
      v.gui = false
    end
    control.vm.provision "shell", path: "scripts/install_worker.sh", args: [SERVER_IP, WORKER_IP]
  end
end
